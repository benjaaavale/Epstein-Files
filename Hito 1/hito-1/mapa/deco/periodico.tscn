[node name="Periodico" type="StaticBody3D"]
script = ExtResource("1_leible")
accion = "Leer periódico"
encabezado = "EL ECO DEL VALLE — MARTES 14 DE OCTUBRE"
titulo = "SEXTA DESAPARICIÓN JUNTO A LA MANSIÓN SHADE"
cuerpo = "Elena Rivas, de 23 años, fue vista por última vez la noche del viernes caminando hacia la antigua mansión Shade, abandonada desde 1974.

Con ella ya son seis las personas desaparecidas en los alrededores de la propiedad durante este año. La policía revisó el lugar sin encontrar rastros.

Vecinos aseguran haber visto, de madrugada, luces rojas y azules moviéndose detrás de las ventanas tapiadas. \"Es como si alguien buscara algo ahí adentro\", declaró uno de ellos."

